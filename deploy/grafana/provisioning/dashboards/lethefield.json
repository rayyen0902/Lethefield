{
  "title": "Lethefield 三线指标（M12）",
  "uid": "lethefield-m12",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "告警线：record_confirm 延迟 p50",
      "description": "histogram_quantile(0.5, lethefield_record_confirm_duration_seconds_bucket)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(lethefield_record_confirm_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "告警线：EX 最后写入年龄",
      "description": "lethefield_ex_last_write_age_seconds（按 dimension 两条序列）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "lethefield_ex_last_write_age_seconds",
          "legendFormat": "{{dimension}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "标定线：θ 过滤比 p50",
      "description": "histogram_quantile(0.5, lethefield_ff_theta_filter_ratio_bucket)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(lethefield_ff_theta_filter_ratio_bucket[5m])) by (le))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "标定线：δ 应用计数（按 type）",
      "description": "lethefield_ff_delta_applied_total 按 type 聚合",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(lethefield_ff_delta_applied_total[5m]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "留痕线：agent 建议计数（按 outcome）",
      "description": "lethefield_agent_suggestion_total 按 outcome 聚合",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(lethefield_agent_suggestion_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "留痕线：升级计数（按 reason）",
      "description": "lethefield_escalation_total 按 reason 聚合",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(lethefield_escalation_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    }
  ]
}
